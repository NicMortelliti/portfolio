---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} | Nic Mortelliti`}
  description={project.data.description}
>
  <main class="border-b border-border bg-background text-foreground">
    <article class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-20">
      <a
        href="/projects/"
        class="mb-10 inline-flex items-center gap-2 text-sm font-medium text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        <span aria-hidden="true">←</span> All projects
      </a>

      <header class="mb-10 border-b border-border pb-10">
        <p class="mb-4 font-mono text-xs tracking-wide text-accent uppercase">
          {project.data.category}
        </p>
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
          {project.data.title}
        </h1>
        <p class="mt-5 text-xl leading-relaxed text-muted">
          {project.data.description}
        </p>
        {project.data.url && (
          <a
            href={project.data.url}
            target="_blank"
            rel="noreferrer"
            class="mt-6 inline-flex items-center gap-2 rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:border-accent/60 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          >
            Visit project <span aria-hidden="true">↗</span>
          </a>
        )}
      </header>

      <div
        class="space-y-6 text-lg leading-relaxed text-muted [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-foreground [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-foreground [&_li]:ml-6 [&_li]:list-disc [&_ol_li]:list-decimal [&_strong]:font-semibold [&_strong]:text-foreground [&_ul]:space-y-2"
      >
        <Content />
      </div>
    </article>
  </main>
</Layout>
