---
import githubLogo from '../assets/github.svg';
---

<footer class="border-t border-border bg-surface text-foreground">
	<div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8">
		<p class="text-sm text-muted">
			<span class="font-medium text-foreground">Nic Mortelliti</span>
			<span aria-hidden="true"> {`\u{2022}`} </span>
			nicweb.dev
		</p>

		<a
			href="https://github.com/NicMortelliti"
			class="inline-flex w-fit items-center gap-2 font-medium text-accent transition-colors hover:text-accent/75"
		>
			<img src={githubLogo.src} alt="" class="size-5" width="20" height="20" />
			GitHub
			<span aria-hidden="true">↗</span>
		</a>
	</div>
</footer>
