---
const timeZone = 'America/Los_Angeles';
const currentDate = new Date();
const dateParts = new Intl.DateTimeFormat('en-US', {
  timeZone,
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).formatToParts(currentDate);
const formattedDate = dateParts
  .filter(({ type }) => type !== 'literal')
  .map(({ value }) => value);
const [month, day, year] = formattedDate;
const dateLabel = `${month} ${day}, ${year}`;
---

<aside class="border-b border-[#e2d59e] bg-[#f4e9bd] text-[#3b3524]" aria-label="Portfolio status">
  <div class="mx-auto flex max-w-7xl flex-col gap-1 px-5 py-3 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <p class="text-[#514a35]">This portfolio is a work in progress. I’m adding project write-ups—thanks for stopping by.</p>
    <p class="shrink-0 text-xs text-[#756c52]">— Nic <time>{dateLabel}</time></p>
  </div>
</aside>
