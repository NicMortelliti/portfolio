
---
const currentPath = Astro.url.pathname;

const navigation = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/work/" },
  { label: "About", href: "/about/" },
];
---

<header class="border-b border-border bg-surface text-foreground">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8">
    <!-- Brand -->
    <a
      href="/"
      class="group flex items-center gap-3"
      aria-label="Nic Mortelliti — Home"
    >
      <span
        class="flex size-10 items-center justify-center rounded-lg bg-surface-raised text-lg font-bold tracking-tighter text-accent transition-colors group-hover:bg-accent group-hover:text-background"
      >
        NM
      </span>

      <span class="text-lg font-semibold tracking-tight">
        nicweb<span class="text-accent">.</span>dev
      </span>
    </a>

    <!-- Navigation -->
    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-6 sm:gap-8">
        {navigation.map(({ label, href }) => {
          const isActive = currentPath === href;

          return (
            <li>
              <a
                href={href}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "text-sm font-medium transition-colors hover:text-accent",
                  isActive ? "text-accent" : "text-muted",
                ]}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
